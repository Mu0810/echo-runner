# Build output
build/
app/build/
.gradle/
.cxx/
.externalNativeBuild/
captures/

# Machine-specific: points at this machine's Android SDK, must not be shared
local.properties

# Build artifacts. The APK is 11 MB and regenerable with ./gradlew assembleDebug
*.apk
*.aab
*.ap_
*.dex
*.class

# Signing material — never commit these
*.jks
*.keystore
keystore.properties

# IDE
.idea/
*.iml
*.iws
*.ipr
out/
.kotlin/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Raw emulator screenshots: 2 MB each and regenerable with adb exec-out screencap.
# The small rendered store graphics (icon, feature) ARE tracked, since they are the
# deliverables and their HTML sources live beside them.
store/shot-*.png
store/feature-1024x500.png
